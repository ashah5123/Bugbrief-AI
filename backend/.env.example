# Keep billing DISABLED on the Google AI Studio project. Never put this key in frontend files.
GEMINI_API_KEY=
# Set true ONLY after checking the key's project has no billing account.
FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=20
AI_TIMEOUT_SECONDS=45
# Optional single-agency access code. Leave empty to generate data/agency-access.txt on startup.
AGENCY_ACCESS_CODE=
# Public requests share the global cap above; these add stricter per-project intake caps.
PUBLIC_AI_DAILY_LIMIT=6
PUBLIC_SUBMISSIONS_DAILY_LIMIT=10
